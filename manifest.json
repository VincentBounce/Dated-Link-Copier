{
  "manifest_version": 3,
  "name": "Dated Link Copier",
  "version": "2.1.1",
  "description": "Copy a dated link to the current page: YouTube videos, Google Play apps, news articles and more.",
  "permissions": ["scripting", "activeTab", "clipboardWrite", "declarativeContent"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Copy dated link",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
